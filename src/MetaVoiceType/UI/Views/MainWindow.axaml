<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MetaVoiceType.UI.ViewModels"
        xmlns:models="using:MetaVoiceType.Core.Models"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:controls="using:MetaVoiceType.UI.Controls"
        x:Class="MetaVoiceType.UI.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="MetaVoiceType" Width="1040" Height="760" MinWidth="620" MinHeight="560"
        Background="{DynamicResource CanvasBrush}" WindowStartupLocation="CenterScreen" KeyDown="WindowKeyDown">
  <Grid>
    <Grid IsVisible="{Binding !ShowOnboarding}" RowDefinitions="68,*">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceBrush}" Padding="28,0">
        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Image Width="36" Height="36" Source="avares://MetaVoiceType/UI/Assets/metavoicetype.png" Stretch="Uniform"/>
            <StackPanel><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="MetaVoiceType" FontWeight="SemiBold" FontSize="19"/><TextBlock Text="{Binding AppVersion}" Classes="subtle" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,2"/></StackPanel><TextBlock Text="Local voice transcription, dictation, and commands" Classes="subtle" FontSize="11"/></StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="11,6" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding State.VoiceModelState}" Classes="muted" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
          </Border>
          <Button Grid.Column="2" Classes="ghost" Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="Settings"><StackPanel Orientation="Horizontal" Spacing="8"><material:MaterialIcon Kind="CogOutline" Width="20"/><TextBlock Text="Settings"/></StackPanel></Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" IsVisible="{Binding !ShowSettings}">
        <StackPanel Margin="34,28" Spacing="20" MaxWidth="920">
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding State.CommandListenerActive}"/>
                <Ellipse Width="9" Height="9" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" IsVisible="{Binding !State.CommandListenerActive}"/>
                <TextBlock Text="{Binding CurrentListenerStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Image Width="100" Height="40" Source="avares://MetaVoiceType/UI/Assets/nvidia-logo.png" Stretch="Uniform" IsVisible="{Binding ShowNvidiaMark}"/><TextBlock Text="{Binding State.EngineLabel}" Classes="muted" VerticalAlignment="Center"/></StackPanel>
              <TextBlock Grid.Row="1" Text="{Binding AnimatedStatusText}" Classes="muted" Margin="17,5,0,0"/>
            </Grid>
          </Border>

          <Grid x:Name="LiveGrid" ColumnDefinitions="*,300" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20">
            <Border Classes="card" MinHeight="220">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Live transcript" Classes="section"/><TextBlock Text="{Binding ElapsedText}" Classes="subtle"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="10,6"><TextBlock Text="{Binding SelectedDictationLanguage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/></Border></Grid>
                <ScrollViewer MaxHeight="132" MinHeight="76" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding State.LiveTranscript}" TextWrapping="Wrap" FontSize="17" LineHeight="26"/></ScrollViewer>
                <TextBlock Text="Start recording and speak naturally. Your audio stays local." Classes="muted" IsVisible="{Binding !State.IsRecording}"/>
                <controls:SpectrumControl Bars="{Binding SpectrumBars}" BarBrush="{DynamicResource AccentBrush}" Height="38"/>
                <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding ShowPasteActivity}"><controls:ActivitySpinner Width="16" Height="16" IsActive="{Binding ShowPasteActivity}" Brush="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding PasteStatusText}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><Button Classes="ghost compact" Content="Cancel paste" Command="{Binding CancelPasteCommand}"/></StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="primary" Command="{Binding ToggleRecordingCommand}" IsVisible="{Binding CanStartRecording}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="7"><material:MaterialIcon Kind="RecordCircleOutline" Width="19"/><TextBlock Text="Start recording"/></StackPanel></Button>
                  <Button Classes="primary" Command="{Binding StopRecordingCommand}" IsVisible="{Binding CanStopRecording}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="7"><material:MaterialIcon Kind="StopCircleOutline" Width="19"/><TextBlock Text="Stop recording"/></StackPanel></Button>
                  <Button Classes="ghost" Command="{Binding ContinueRecordingCommand}" IsEnabled="{Binding CanCopyCurrent}" IsVisible="{Binding CanStartRecording}" ToolTip.Tip="Continue the latest transcript" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="6"><material:MaterialIcon Kind="Refresh" Width="18"/><TextBlock Text="Continue"/></StackPanel></Button>
                  <Button Classes="ghost" Command="{Binding CopyCommand}" IsEnabled="{Binding CanCopyCurrent}" ToolTip.Tip="Copy"><material:MaterialIcon Kind="ContentCopy" Width="19"/></Button>
                  <Button Classes="ghost" Command="{Binding PasteCommand}" IsEnabled="{Binding CanPaste}" ToolTip.Tip="Paste Recording"><material:MaterialIcon Kind="ContentPaste" Width="19"/></Button>
                  <Button Classes="ghost danger" Command="{Binding CancelRecordingCommand}" IsVisible="{Binding State.IsRecording}" ToolTip.Tip="Cancel recording"><material:MaterialIcon Kind="Close" Width="19"/></Button>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border x:Name="CommandCard" Grid.Column="1" Classes="card">
              <StackPanel Spacing="11"><TextBlock Text="{Binding AnimatedStatusText}" Classes="section" TextWrapping="Wrap"/><TextBlock Text="Voice command examples" Classes="subtle"/><Border Classes="soft"><TextBlock Text="{Binding RecordingCommandExamples}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13" LineHeight="21" TextWrapping="Wrap"/></Border><TextBlock Text="See full command list in the settings" Classes="muted" FontSize="12"/><TextBlock Text="Keyboard shortcut" Classes="subtle"/><Border Classes="soft"><TextBlock Text="{Binding HotkeyGesture}" FontWeight="SemiBold" TextWrapping="Wrap"/></Border></StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Recent" Classes="heading" FontSize="20"/><Button Grid.Column="1" Classes="ghost danger compact" Content="Delete all" Command="{Binding RequestDeleteAllCommand}" IsEnabled="{Binding HasHistory}"/></Grid>
          <Border Classes="soft" IsVisible="{Binding IsDeleteConfirmationVisible}"><TextBlock Text="Click the same delete button again within 4 seconds to confirm." Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/></Border>
          <Border Classes="soft" IsVisible="{Binding ShowDeleteAllConfirmation}"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="Delete all transcript history?" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="ghost" Content="Cancel" Command="{Binding CancelDeleteAllCommand}"/><Button Grid.Column="2" Classes="danger" Content="Delete all" Command="{Binding ConfirmDeleteAllCommand}"/></Grid></Border>
          <ItemsControl ItemsSource="{Binding State.History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:TranscriptRecord">
                <Border Classes="card" Padding="17" Margin="0,0,0,9">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="68" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding LocalTimeDisplay}" Classes="subtle" FontSize="12" Margin="0,7,0,0"/>
                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="3" Margin="14,0,0,0" VerticalAlignment="Center">
                      <Button Classes="ghost" Tag="{Binding}" Click="CopyHistoryClicked" ToolTip.Tip="Copy exact transcript"><material:MaterialIcon Kind="ContentCopy" Width="18"/></Button>
                      <Button Classes="ghost danger" Tag="{Binding}" Click="DeleteHistoryClicked" ToolTip.Tip="Click twice to delete"><material:MaterialIcon Kind="DeleteOutline" Width="18"/></Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="1" IsVisible="{Binding ShowSettings}" RowDefinitions="Auto,*">
        <Grid Margin="30,22,30,14" ColumnDefinitions="Auto,*"><Button Classes="ghost" Command="{Binding ToggleSettingsCommand}"><material:MaterialIcon Kind="ArrowLeft" Width="20"/></Button><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Settings" Classes="heading"/><TextBlock Text="Changes stay on this PC." Classes="muted"/></StackPanel></Grid>
        <TabControl Grid.Row="1" Margin="28,0,28,26" SelectedIndex="{Binding SettingsTabIndex}">
          <TabItem Header="General"><ScrollViewer><StackPanel Margin="8,18" Spacing="16">
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="Appearance &amp; startup" Classes="section"/><Grid ColumnDefinitions="190,*"><TextBlock Text="Theme" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/></Grid><CheckBox Content="Start MetaVoiceType when I sign in" IsChecked="{Binding StartWithWindows}"/><CheckBox Content="Copy transcript when recording stops" IsChecked="{Binding CopyOnStop}"/><CheckBox Content="Show floating recording pill" IsChecked="{Binding ShowFloatingPill}"/></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Recording shortcut" Classes="section"/><TextBlock Text="Choose a global shortcut with at least one modifier." Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Text="{Binding HotkeyGesture}" Width="230" IsReadOnly="True"/><Button Content="Record shortcut" Command="{Binding BeginHotkeyCaptureCommand}"/><Button Content="Reset" Classes="ghost" Command="{Binding ResetHotkeyCommand}"/></StackPanel><TextBlock Text="{Binding HotkeyValidation}" Foreground="{DynamicResource WarningBrush}"/></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Recording event shortcuts" Classes="section"/><TextBlock Text="Tap shortcuts at recording boundaries, or hold a keybind for the entire recording." Classes="muted" TextWrapping="Wrap"/><Grid ColumnDefinitions="190,230,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="7"><TextBlock Text="When recording starts" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding RecordingStartedShortcut}" IsReadOnly="True" PlaceholderText="Not set"/><Button Grid.Column="2" Content="Record" Command="{Binding BeginRecordingStartedShortcutCaptureCommand}"/><Button Grid.Column="3" Classes="ghost" Content="Clear" Command="{Binding ClearRecordingStartedShortcutCommand}"/><TextBlock Grid.Row="1" Text="When recording stops" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecordingStoppedShortcut}" IsReadOnly="True" PlaceholderText="Not set"/><Button Grid.Row="1" Grid.Column="2" Content="Record" Command="{Binding BeginRecordingStoppedShortcutCaptureCommand}"/><Button Grid.Row="1" Grid.Column="3" Classes="ghost" Content="Clear" Command="{Binding ClearRecordingStoppedShortcutCommand}"/><TextBlock Grid.Row="2" Text="Hold while recording" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RecordingHeldShortcut}" IsReadOnly="True" PlaceholderText="Not set"/><Button Grid.Row="2" Grid.Column="2" Content="Record" Command="{Binding BeginRecordingHeldShortcutCaptureCommand}"/><Button Grid.Row="2" Grid.Column="3" Classes="ghost" Content="Clear" Command="{Binding ClearRecordingHeldShortcutCommand}"/></Grid><TextBlock Text="Use Hold while recording with Discord Push to Mute, push-to-talk, OBS, or any workflow that reacts while a keybind remains down." Classes="subtle" TextWrapping="Wrap"/></StackPanel></Border>
            <Button Classes="primary" Content="Save general settings" Command="{Binding ApplySettingsCommand}" HorizontalAlignment="Right"/>
          </StackPanel></ScrollViewer></TabItem>

          <TabItem Header="Voice commands"><ScrollViewer><StackPanel Margin="8,18" Spacing="16">
            <Border Classes="card"><StackPanel Spacing="13"><TextBlock Text="Vosk command listener" Classes="section"/><TextBlock Text="This language controls only the always-on command phrases. Parakeet dictation language is independent." Classes="muted" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedVoiceLanguage}" DisplayMemberBinding="{Binding DisplayName}"/><TextBlock Text="{Binding VoiceLanguageStatus}" Foreground="{DynamicResource SuccessBrush}"/><Button Content="Download and activate selected language" Command="{Binding DownloadVoiceModelCommand}" IsEnabled="{Binding !IsDownloading}" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="11"><TextBlock Text="Built-in aliases" Classes="section"/><TextBlock Text="Add distinct ways to say each action. Paste Recording is primary; Paste Here remains a default English alias." Classes="muted" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding BuiltInAliasEditors}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CommandAliasEditorViewModel"><Grid ColumnDefinitions="190,*" Margin="0,0,0,10"><TextBlock Text="{Binding Label}" VerticalAlignment="Top" Margin="0,8,0,0"/><controls:AliasListEditor Grid.Column="1" DataContext="{Binding Aliases}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Reset this language" Command="{Binding ResetCommandsCommand}"/><TextBlock Text="{Binding CommandValidation}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/></StackPanel></StackPanel></Border>
          </StackPanel></ScrollViewer></TabItem>

          <TabItem Header="Custom commands"><ScrollViewer><StackPanel Margin="8,18" Spacing="16">
            <Grid ColumnDefinitions="280,*" ColumnSpacing="16">
              <Border Classes="card"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Commands" Classes="section"/><Button Grid.Column="1" Classes="primary" Content="Add" Command="{Binding AddCustomCommandCommand}"/></Grid><TextBlock Text="New commands use the currently selected Vosk language." Classes="subtle" FontSize="12" TextWrapping="Wrap"/><ListBox ItemsSource="{Binding CustomCommands}" SelectedItem="{Binding SelectedCustomCommand}" MinHeight="300"><ListBox.ItemTemplate><DataTemplate x:DataType="models:CustomVoiceCommand"><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Phrase}" Classes="subtle" FontSize="12"/><TextBlock Text="{Binding VoiceCommandLanguageId, StringFormat='Command language: {0}'}" Classes="subtle" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
              <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasSelectedCustomCommand}"><StackPanel Spacing="11"><TextBlock Text="Command details" Classes="section"/><TextBlock Text="Name" Classes="subtle"/><TextBox Text="{Binding SelectedCustomCommand.Name}"/><TextBlock Text="Spoken aliases" Classes="subtle"/><controls:AliasListEditor DataContext="{Binding CustomAliases}"/><TextBlock Text="Short or common phrases may trigger accidentally during normal speech. Longer, distinctive phrases are more reliable." Classes="subtle" TextWrapping="Wrap"/><TextBlock Text="Action type" Classes="subtle"/><ComboBox ItemsSource="{Binding CustomCommandTypes}" SelectedItem="{Binding SelectedCustomCommandType}"/><StackPanel Spacing="7" IsVisible="{Binding ShowProgramFields}"><TextBlock Text="Program path" Classes="subtle"/><TextBox Text="{Binding SelectedCustomCommand.Executable}" PlaceholderText="C:\Path\Application.exe"/><TextBlock Text="Arguments" Classes="subtle"/><TextBox Text="{Binding SelectedCustomCommand.Arguments}"/></StackPanel><StackPanel Spacing="7" IsVisible="{Binding ShowScriptFields}"><TextBlock Text="PowerShell / Command Prompt text" Classes="subtle"/><TextBox Text="{Binding SelectedCustomCommand.ScriptOrCommand}" AcceptsReturn="True" MinHeight="68"/></StackPanel><StackPanel Spacing="7" IsVisible="{Binding ShowShortcutFields}"><TextBlock Text="Keyboard shortcut" Classes="subtle"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Text="{Binding SelectedCustomCommand.Shortcut}" IsReadOnly="True" Width="230"/><Button Content="Record shortcut" Command="{Binding BeginCustomShortcutCaptureCommand}"/></StackPanel></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding !ShowShortcutFields}"><StackPanel><TextBlock Text="Working directory" Classes="subtle"/><TextBox Text="{Binding SelectedCustomCommand.WorkingDirectory}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Window" Classes="subtle"/><ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding SelectedCustomCommand.WindowMode}"/></StackPanel></Grid><CheckBox Content="Enabled" IsChecked="{Binding SelectedCustomCommand.Enabled}"/><TextBlock Text="{Binding CustomCommandValidation}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="primary" Content="Save command" Command="{Binding SaveCustomCommandCommand}"/><Button Classes="ghost danger" Content="Delete" Command="{Binding DeleteCustomCommandCommand}" CommandParameter="{Binding SelectedCustomCommand}"/></StackPanel></StackPanel></Border>
              <Border Grid.Column="1" Classes="soft" IsVisible="{Binding !HasSelectedCustomCommand}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><material:MaterialIcon Kind="GestureTap" Width="32" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Select a command or add a new one" Classes="muted"/></StackPanel></Border>
            </Grid>
          </StackPanel></ScrollViewer></TabItem>

          <TabItem Header="Replacements"><ScrollViewer><StackPanel Margin="8,18" Spacing="14">
            <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Word replacements" Classes="section"/><TextBlock Text="Literal, case-insensitive, boundary-aware corrections applied before history, copy, and paste." Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="primary" Content="+ Add replacement" Command="{Binding AddWordReplacementCommand}"/></Grid>
            <ItemsControl ItemsSource="{Binding ReplacementGroups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ReplacementGroupEditorViewModel"><Border Classes="card" Padding="13" Margin="0,0,0,7"><Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="9"><StackPanel Spacing="5"><TextBlock Text="Match any alias" Classes="subtle"/><controls:AliasListEditor DataContext="{Binding Matches}"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Replace with" Classes="subtle"/><TextBox Text="{Binding Replacement}" PlaceholderText="Replacement text"/></StackPanel><Button Grid.Column="2" Classes="ghost danger" Tag="{Binding}" Click="DeleteReplacementClicked" ToolTip.Tip="Delete replacement group"><material:MaterialIcon Kind="DeleteOutline" Width="18"/></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><TextBlock Text="{Binding CommandValidation}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/><Button Classes="primary" Content="Save replacements" Command="{Binding SaveWordReplacementsCommand}"/></StackPanel>
          </StackPanel></ScrollViewer></TabItem>

          <TabItem Header="Audio &amp; models"><ScrollViewer><StackPanel Margin="8,18" Spacing="16">
            <Border Classes="card"><StackPanel Spacing="13"><TextBlock Text="Audio &amp; dictation" Classes="section"/><Grid ColumnDefinitions="190,*"><TextBlock Text="Microphone"/><ComboBox Grid.Column="1" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" DisplayMemberBinding="{Binding Name}"/></Grid><Grid ColumnDefinitions="190,*"><TextBlock Text="Dictation mode"/><ComboBox Grid.Column="1" ItemsSource="{Binding DictationLanguages}" SelectedItem="{Binding SelectedDictationLanguage}"/></Grid><TextBlock Text="Automatic uses Parakeet V3 multilingual detection. English uses Parakeet V2. This does not change the Vosk command language." Classes="muted" TextWrapping="Wrap"/><CheckBox Content="CPU-only mode (GPU remains preferred when this is off)" IsChecked="{Binding ForceCpuOnly}"/><Grid ColumnDefinitions="190,*,Auto" ColumnSpacing="8"><TextBlock Text="Command cue volume" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding CueVolume}"/><Button Grid.Column="2" Content="Test" Command="{Binding TestCueCommand}"/></Grid></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Models" Classes="section"/><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="9"><StackPanel><TextBlock Text="Parakeet V3" FontWeight="SemiBold"/><TextBlock Text="Automatic · 25 languages" Classes="subtle"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ParakeetV3Status}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/><StackPanel Grid.Row="1"><TextBlock Text="Parakeet V2" FontWeight="SemiBold"/><TextBlock Text="English" Classes="subtle"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParakeetV2Status}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/><StackPanel Grid.Row="2"><TextBlock Text="Acceleration" FontWeight="SemiBold"/><TextBlock Text="CUDA preferred · automatic CPU fallback" Classes="subtle"/></StackPanel><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccelerationStatus}" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Text="{Binding CurrentListenerStatus}" Classes="muted"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding State.VoiceModelState}" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding State.ProviderFallbackReason}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{Binding VoiceModelActionText}" Command="{Binding DownloadVoiceModelCommand}"/><Button Content="Install selected dictation model" Command="{Binding DownloadDictationAssetsCommand}"/><Button Classes="primary" Content="Retry" Command="{Binding RetryDownloadCommand}" IsVisible="{Binding DownloadFailed}"/></StackPanel><ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" IsVisible="{Binding IsDownloading}"/><TextBlock Text="{Binding DownloadStatus}"/><TextBlock Text="{Binding DownloadDetail}" Classes="subtle"/><Button Content="Cancel download" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" HorizontalAlignment="Left"/></StackPanel></Border>
          </StackPanel></ScrollViewer></TabItem>

          <TabItem Header="Version &amp; updates"><ScrollViewer><StackPanel Margin="8,18" Spacing="16">
            <Border Classes="card"><StackPanel Spacing="5"><TextBlock Text="Version" Classes="section"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="MetaVoiceType" Classes="heading"/><TextBlock Text="{Binding AppVersion}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Private local voice transcription, dictation, and commands." Classes="muted"/></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="11"><TextBlock Text="Updates" Classes="section"/><TextBlock Text="{Binding UpdateStatus}" Classes="muted" TextWrapping="Wrap"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdatePercent}" Height="8" IsVisible="{Binding IsUpdating}"/><TextBlock Text="{Binding UpdatePercent, StringFormat='{}{0:F0}%'}" Classes="subtle" HorizontalAlignment="Right" IsVisible="{Binding IsUpdating}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsUpdating}"/><Button Classes="primary" Content="Download and restart" Command="{Binding UpdateNowCommand}" IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !IsUpdating}"/></StackPanel></StackPanel></Border>
          </StackPanel></ScrollViewer></TabItem>

          <TabItem Header="Credits"><ScrollViewer><StackPanel Margin="8,18" Spacing="14"><TextBlock Text="Credits" Classes="heading"/><TextBlock Text="MetaVoiceType is built with these open-source GitHub libraries and projects." Classes="muted" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Credits}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CreditItem"><Border Classes="card" Padding="14" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Classes="ghost" Content="GitHub" Tag="{Binding Url}" Click="OpenLinkClicked" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="NVIDIA Parakeet model and CUDA notices are documented separately because they are not GitHub libraries." Classes="subtle" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <Grid IsVisible="{Binding ShowOnboarding}" Background="{DynamicResource CanvasBrush}">
      <Border Classes="card" Width="680" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="38">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="MetaVoiceType" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding OnboardingStep, StringFormat='Step {0} of 7'}" Classes="subtle"/></Grid><ProgressBar Minimum="1" Maximum="7" Value="{Binding OnboardingStep}" Height="4"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,30" Spacing="18" IsVisible="{Binding IsWelcomeStep}"><TextBlock Text="Private dictation that stays local" Classes="heading"/><TextBlock Text="MetaVoiceType listens locally for your chosen voice commands while it runs—even from the system tray." TextWrapping="Wrap" FontSize="16"/><Border Classes="soft"><TextBlock Text="Ordinary speech is not retained. Dictation audio is captured only after Start Recording, transcribed on this PC, and deleted after its transcript is safely stored." Classes="muted" TextWrapping="Wrap" LineHeight="22"/></Border></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,30" Spacing="15" IsVisible="{Binding IsVoiceStep}"><TextBlock Text="Choose your command language" Classes="heading"/><TextBlock Text="Vosk recognizes commands such as “start recording.” This choice never limits the language you dictate." Classes="muted" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedVoiceLanguage}" DisplayMemberBinding="{Binding DisplayName}"/><TextBlock Text="The next step downloads the matching offline command model." Classes="subtle"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,30" Spacing="14" IsVisible="{Binding IsVoiceDownloadStep}"><TextBlock Text="Install command recognition" Classes="heading"/><TextBlock Text="{Binding VoiceLanguageStatus}" FontSize="16"/><Button Classes="primary" Content="Download and activate Vosk model" Command="{Binding DownloadVoiceModelCommand}" IsEnabled="{Binding !IsDownloading}" HorizontalAlignment="Left"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}"/><TextBlock Text="{Binding DownloadStatus}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="Continue unlocks only after the selected language is active." Classes="subtle"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,30" Spacing="14" IsVisible="{Binding IsDictationStep}"><TextBlock Text="Install Parakeet dictation" Classes="heading"/><TextBlock Text="Choose Automatic for multilingual Parakeet v3 or English for Parakeet v2. MetaVoiceType first tries the verified NVIDIA CUDA runtime and falls back cleanly to CPU." Classes="muted" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding DictationLanguages}" SelectedItem="{Binding SelectedDictationLanguage}"/><Button Classes="primary" Content="Download and initialize dictation" Command="{Binding DownloadDictationAssetsCommand}" IsEnabled="{Binding !IsDownloading}" HorizontalAlignment="Left"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}"/><TextBlock Text="{Binding DownloadStatus}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="Continue unlocks only after an actual recognizer warm-up succeeds." Classes="subtle"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,30" Spacing="16" IsVisible="{Binding IsMicrophoneStep}"><StackPanel Orientation="Horizontal" Spacing="12"><material:MaterialIcon Kind="Microphone" Width="34" Height="34" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="Choose a microphone" Classes="heading" VerticalAlignment="Center"/></StackPanel><ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" DisplayMemberBinding="{Binding Name}"/><controls:SpectrumControl Bars="{Binding SpectrumBars}" BarBrush="{DynamicResource AccentBrush}" Height="56"/><TextBlock Text="Speak to test it. You can switch devices later in Settings." Classes="muted"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,30" Spacing="16" IsVisible="{Binding IsStartupStep}"><TextBlock Text="Start with Windows?" Classes="heading"/><CheckBox Content="Start MetaVoiceType when I sign in" IsChecked="{Binding StartWithWindows}"/><TextBlock Text="When MetaVoiceType runs, its selected Vosk command model listens locally for configured command phrases." Classes="muted" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,30" Spacing="16" IsVisible="{Binding IsReadyStep}"><TextBlock Text="You're ready" Classes="heading"/><TextBlock Text="Say this phrase or use your keyboard shortcut:" FontSize="16"/><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="13" Padding="18"><StackPanel Spacing="7"><TextBlock Text="{Binding StartRecordingPhrase}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding HotkeyGesture}" Classes="muted"/></StackPanel></Border><TextBlock Text="Your command language and dictation language remain independent." Classes="subtle"/></StackPanel>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto"><Button Content="Back" Command="{Binding PreviousOnboardingCommand}" IsVisible="{Binding !IsWelcomeStep}"/><Button x:Name="OnboardingContinueButton" Grid.Column="2" Classes="primary" Content="Continue" Command="{Binding NextOnboardingCommand}" IsVisible="{Binding !IsReadyStep}" IsEnabled="{Binding CanContinueOnboarding}"/><Button Grid.Column="2" Classes="primary" Content="Finish setup" Command="{Binding FinishOnboardingCommand}" IsVisible="{Binding IsReadyStep}"/></Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
