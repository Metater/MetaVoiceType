<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MetaVoiceType.UI.Views.TrayNoticeWindow"
        Width="390" Height="118" CanResize="False" ShowInTaskbar="False"
        WindowDecorations="None" Topmost="True" ShowActivated="False"
        TransparencyLevelHint="AcrylicBlur" Background="#F21A1D28">
  <Border BorderBrush="#4D7C5CFC" BorderThickness="1" CornerRadius="15" Padding="18">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
      <Border Width="38" Height="38" CornerRadius="11" Background="#7C5CFC">
        <TextBlock Text="M" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
      </Border>
      <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock Text="MetaVoiceType is still running" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Voice commands remain available from the system tray. Choose Exit there to stop listening." Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
