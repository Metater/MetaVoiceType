<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MetaVoiceType.UI.ViewModels"
        xmlns:material="using:Material.Icons.Avalonia"
        x:Class="MetaVoiceType.UI.Views.PillWindow"
        x:DataType="vm:MainViewModel"
        Width="430" Height="68" SizeToContent="Manual"
        WindowDecorations="None" CanResize="False" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Background="Transparent" TransparencyLevelHint="AcrylicBlur,Transparent">
  <Border Background="#F2181B25" CornerRadius="22" BorderBrush="#353A48" BorderThickness="1" Padding="18,10" BoxShadow="0 10 28 0 #66000000">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="11">
      <Ellipse Width="12" Height="12" Fill="#FF5573" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Recording" FontWeight="SemiBold"/><TextBlock Text="Listening locally" FontSize="11" Foreground="#969CAD"/></StackPanel>
      <ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding State.AudioLevel}" Height="5" Margin="8,0" VerticalAlignment="Center"/>
      <Button Grid.Column="3" Classes="ghost" Command="{Binding CopyCommand}" ToolTip.Tip="Copy current transcript"><material:MaterialIcon Kind="ContentCopy" Width="20"/></Button>
      <Button Grid.Column="4" Classes="ghost" Command="{Binding PasteCommand}" ToolTip.Tip="Paste here"><material:MaterialIcon Kind="ContentPaste" Width="20"/></Button>
      <Button Grid.Column="5" Classes="ghost" Command="{Binding CancelRecordingCommand}" ToolTip.Tip="Cancel and save"><material:MaterialIcon Kind="Close" Width="20"/></Button>
    </Grid>
  </Border>
</Window>
