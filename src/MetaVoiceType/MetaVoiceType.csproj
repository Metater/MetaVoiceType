<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MetaVoiceType</AssemblyName>
    <RootNamespace>MetaVoiceType</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>UI\Assets\metavoicetype.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="Vosk" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="SharpHook" />
    <PackageReference Include="TextCopy" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="UI/Assets/**" />
    <EmbeddedResource Include="Resources/*.json" />
    <Content Include="Resources/Sounds/*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
