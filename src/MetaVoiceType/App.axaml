<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MetaVoiceType.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" /></Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C5CFC"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18,11"/>
    </Style>
    <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#161922"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#969CAD"/></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/UI/Assets/metavoicetype.ico" ToolTipText="MetaVoiceType — command listening active" Clicked="OpenFromTray">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open MetaVoiceType" Click="OpenFromTray" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit MetaVoiceType" Click="ExitFromTray" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
